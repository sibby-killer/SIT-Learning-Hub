# =============================================================================
# SIT Learning Hub - environment variable template
# Copy this file to .env.local and fill in values. NEVER commit .env.local.
# See docs/API-KEYS.md for where to obtain each value.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
# Comma-separated emails allowed to bootstrap the first administrator.
ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# Database - Turso / libSQL (Phase 1)
# Local dev may use: TURSO_DATABASE_URL=file:./.data/local.db
# Remote: libsql://<database>-<org>.turso.io
# -----------------------------------------------------------------------------
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Authentication - Clerk (Phase 1)
# Publishable key is safe for the browser; secret key is server-only.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional until a Clerk webhook is configured.
CLERK_WEBHOOK_SIGNING_SECRET=

# -----------------------------------------------------------------------------
# AI - Groq + Mastra (Phase 4 grading, Phase 9 agent)
# Mastra model-router IDs include the provider prefix.
# Recommended primary: groq/openai/gpt-oss-120b
# Recommended fast:    groq/openai/gpt-oss-20b
# -----------------------------------------------------------------------------
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=groq/openai/gpt-oss-120b
GROQ_FAST_MODEL=groq/openai/gpt-oss-20b

# -----------------------------------------------------------------------------
# Object storage - Cloudflare R2 (Phase 6-8; optional before then)
# Recommended for original exam PDFs and evidence uploads (10 GB free tier).
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# -----------------------------------------------------------------------------
# OCR / document processing (Phase 6; optional)
# Default pipeline uses pdfjs-dist + tesseract.js and needs no key.
# -----------------------------------------------------------------------------
OCR_PROVIDER=local
OCR_SPACE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# -----------------------------------------------------------------------------
# Rate limiting / observability (optional; Phase 11)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Scheduled jobs / internal endpoints
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
CRON_SECRET=
